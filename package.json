{
  "name": "microvm",
  "version": "0.1.0",
  "description": "Effect v4 Firecracker microVM runtime: authenticated RPC cluster daemons, jailed sandboxed Linux VMs, Vercel AI SDK sandbox tools",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./cluster": {
      "types": "./dist/cluster.d.ts",
      "import": "./dist/cluster.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "microvm-daemon": "./dist/bin/daemon.js",
    "microvm": "./dist/bin/client.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check-all": "pnpm typecheck && pnpm build && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/platform-node-shared": "4.0.0-beta.107",
    "ai": "7.0.99",
    "effect": "4.0.0-beta.107",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
